# ─────────────────────────────────────────────────────────────
# 统一 AI 生图配置文件示例（重命名或复制为 .env 使用）
# ─────────────────────────────────────────────────────────────
# 安全提示：支持以 base64 格式保存 API Key（避免明文泄露）
# 生成 base64 命令：python3 image_gen.py --encode-key "sk-你的key"
# 配置方式（两种格式均可）：
#   方式 1（推荐前缀）：QWEN_API_KEY=base64:c2stxxxxxxxxxx
#   方式 2（后缀模式）：QWEN_API_KEY_B64=c2stxxxxxxxxxx
# 脚本读取时会自动解密还原，也向下兼容原生明文 key。
# ─────────────────────────────────────────────────────────────

# 当前启用的生图后端平台（必选）
# 推荐核心后端：openai / qwen / zhipu / gemini / volcengine
IMAGE_BACKEND=openai

# 批量任务并发请求数（默认 3）
IMAGE_CONCURRENCY=3

# ─────────────────────────────────────────────────────────────
# 1. 阿里通义千问 / 万相（DashScope）
# ─────────────────────────────────────────────────────────────
# 示例：base64 编码后的密钥（明文为 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx）
# QWEN_API_KEY=base64:c2steHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4
# QWEN_MODEL=qwen-image-2.0-pro
# 可选自定义端点：
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ─────────────────────────────────────────────────────────────
# 2. OpenAI / OpenAI-Compatible（支持官方及各种第三方中转站/OneAPI）
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=base64:c2steHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4==
OPENAI_MODEL=gpt-image-2.5-sunburst
# 若使用第三方聚合中转 API，请配置你的代理地址：
OPENAI_BASE_URL=https://api.your-proxy.com/v1

# ─────────────────────────────────────────────────────────────
# 3. 智谱 AI（GLM-Image / BigModel）
# ─────────────────────────────────────────────────────────────
# ZHIPU_API_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxx
# ZHIPU_MODEL=glm-image
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/images/generations

# ─────────────────────────────────────────────────────────────
# 4. Google Gemini
# ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-3.1-flash-image
# GEMINI_BASE_URL=https://your-proxy-url.com

# ─────────────────────────────────────────────────────────────
# 5. 火山引擎即梦（Seedream）
# ─────────────────────────────────────────────────────────────
# LAS_API_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxx
# VOLCENGINE_MODEL=doubao-seedream-4-5-251128
